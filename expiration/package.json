    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13"
